# Copy this file to .env and fill in the values from your Supabase project
# (Project settings → API). Never commit the real values — .env is gitignored.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Everything below is optional. With none of it set the site runs exactly as it
# does today: the pricing page sells the plans, the no-card trial works, and the
# paid buttons route to signup instead of to a checkout that cannot complete.
#
# Only VITE_ variables belong in .env. The rest are SECRET and must be set on
# Netlify (Site configuration → Environment variables) — never here, never in
# the repository, and never with a VITE_ prefix, which would publish them in the
# browser bundle. Netlify's secrets scanner will fail the build if you try.

# Turns the paid membership buttons on in the browser. Leave unset until the
# Stripe keys below are live on Netlify.
# VITE_PAYMENTS_ENABLED=true

# --- Stripe Payment Links: the real checkout, for demo mode only ---
#
# A Payment Link is a Stripe-hosted checkout page with no server behind it, so
# it works while the proper integration is still blocked on Supabase. Set these
# and step 3 of the /demo walkthrough hands over to the genuine Stripe page
# instead of the built-in stand-in.
#
# These URLs are public by design — they are meant to be handed out — so VITE_
# is correct here. Use TEST MODE links (buy.stripe.com/test_...) for a
# walkthrough: no money moves and a real card is declined.
#
# In Stripe: Payment Links → New → pick the existing price → under "After
# payment" choose "Redirect customers to your website" and set it to
#   https://<your-site>/dashboard/settings?checkout=success
# without which the client pays and lands back on a page that hasn't noticed.
#
# Only student_complete is needed for a walkthrough; the others are optional.
# VITE_STRIPE_PAYMENT_LINK_STUDENT_COMPLETE=https://buy.stripe.com/test_...
# VITE_STRIPE_PAYMENT_LINK_FAMILY=https://buy.stripe.com/test_...
# VITE_STRIPE_PAYMENT_LINK_TUTOR=https://buy.stripe.com/test_...

# --- Netlify environment variables (do NOT put real values in this file) ---
#
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...          from the endpoint you create in Stripe
#
# Recurring price ids, created in Stripe → Product catalogue:
# STRIPE_PRICE_STUDENT_COMPLETE=price_...      £17.99 / month
# STRIPE_PRICE_FAMILY_BASE=price_...           £27.98 / month, covers two students
# STRIPE_PRICE_FAMILY_EXTRA_STUDENT=price_...  £9.99 / month each, quantity-based
# STRIPE_PRICE_TUTOR=price_...                 £39.99 / month
#
# Lets the webhook write subscription state that no browser may write.
# Supabase → Project settings → API → service_role. Treat it like a password.
# SUPABASE_SERVICE_ROLE_KEY=...
#
# See docs/PAYMENTS.md for the full setup, including the webhook endpoint.
